# PremSight local development (docker-compose)
# Copy to .env and adjust as needed.

COMPOSE_PROJECT_NAME=premsight

# PostgreSQL
POSTGRES_USER=premsight
POSTGRES_PASSWORD=premsight
POSTGRES_DB=premsight
# Host port 5433 avoids clashes with other local Postgres (e.g. another Compose stack on 5432).
# Containers still talk to Postgres on internal port 5432 via hostname `postgres`.
POSTGRES_PORT=5433
DATABASE_URL=postgresql://premsight:premsight@postgres:5432/premsight

# Redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# API
API_PORT=8000
API_HOST=0.0.0.0
API_CORS_ORIGINS=http://localhost:3000
# Session signing key for sign-in cookies. Replace in any shared or production environment.
AUTH_SECRET=dev-insecure-premsight-auth-secret
# Cross-site deployments (Vercel frontend + separate API host) need AUTH_COOKIE_SAMESITE=none
# and AUTH_COOKIE_SECURE=true, plus the Vercel origin in API_CORS_ORIGINS.
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_SECURE=false
# Google OAuth. Leave empty locally until you create the provider app.
# Google redirect URI: http://localhost:8000/v1/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/v1/auth/google/callback

# Prediction engine
PREDICTION_ENGINE_PORT=8001
PREDICTION_ENGINE_HOST=0.0.0.0

# Web
WEB_PORT=3000
# Server-side fetches (Docker service name, or the public API URL on Vercel).
INTERNAL_API_URL=http://api:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_PREDICTION_ENGINE_URL=http://localhost:8001

# Ingestion / fixture refresh scheduler
INGESTION_PORT=8002
INGESTION_HOST=0.0.0.0
FOOTBALL_DATA_API_TOKEN=
FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4
SCHEDULE_ENABLED=true
SCHEDULE_INTERVAL_SECONDS=900
SCHEDULE_RUN_ON_STARTUP=true
INGEST_COMPETITION=PL

# Environment
ENVIRONMENT=development
LOG_LEVEL=info
