# PremSight local development (docker-compose)
# Copy to .env and adjust as needed.

COMPOSE_PROJECT_NAME=premsight

# PostgreSQL
POSTGRES_USER=premsight
POSTGRES_PASSWORD=premsight
POSTGRES_DB=premsight
# Host port 5433 avoids clashes with other local Postgres (e.g. another Compose stack on 5432).
# Containers still talk to Postgres on internal port 5432 via hostname `postgres`.
POSTGRES_PORT=5433
DATABASE_URL=postgresql://premsight:premsight@postgres:5432/premsight

# Redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# API
API_PORT=8000
API_HOST=0.0.0.0
API_CORS_ORIGINS=http://localhost:3000

# Prediction engine
PREDICTION_ENGINE_PORT=8001
PREDICTION_ENGINE_HOST=0.0.0.0

# Web
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_PREDICTION_ENGINE_URL=http://localhost:8001

# Ingestion / fixture refresh scheduler
INGESTION_PORT=8002
INGESTION_HOST=0.0.0.0
FOOTBALL_DATA_API_TOKEN=
FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4
SCHEDULE_ENABLED=true
SCHEDULE_INTERVAL_SECONDS=900
SCHEDULE_RUN_ON_STARTUP=true
INGEST_COMPETITION=PL

# Environment
ENVIRONMENT=development
LOG_LEVEL=info
